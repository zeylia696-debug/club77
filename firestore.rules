rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls les comptes connectés (patronne et manager) peuvent lire et écrire.
    // Les comptes sont créés à la main dans Firebase > Authentication.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
